{
    "name": "order-search",
    "version": "1.0.0",
    "description": "Order search with proxy",
    "main": "server/index.js",
    "scripts": {
        "dev": "vite",
        "type-check": "vue-tsc --noEmit",
        "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\" && tsx --test \"tests/**/*.test.ts\"",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "server:dev": "NODE_ENV=development node server/index.js",
        "server:prod": "node server/index.js",
        "db:migrate:add-order-category": "node server/scripts/migrate_add_order_category.js",
        "db:migrate:formulas": "node server/scripts/migrate_formulas_to_sqlite.js",
        "db:migrate:formula-keys": "node server/scripts/migrate_formula_keys_to_generated_format.js",
        "db:export:formulas": "node server/scripts/export_formulas_to_json.js",
        "start": "npm run server:prod"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@tanstack/vue-table": "^8.21.3",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^14.2.0",
        "axios": "^1.13.4",
        "body-parser": "^2.2.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cors": "^2.8.5",
        "express": "^4.22.1",
        "http-proxy-middleware": "^2.0.6",
        "jsdom": "^27.4.0",
        "lucide-vue-next": "^0.563.0",
        "pinia": "^3.0.4",
        "puppeteer": "^24.34.0",
        "reka-ui": "^2.8.0",
        "sequelize": "^6.37.7",
        "sqlite3": "^5.1.7",
        "tailwind-merge": "^3.4.0",
        "vee-validate": "^4.15.1",
        "vue-router": "^5.0.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^25.1.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "autoprefixer": "^10.4.24",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vue": "^3.5.27",
        "vue-tsc": "^3.2.4"
    }
}
