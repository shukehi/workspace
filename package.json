{
    "name": "order-search",
    "version": "1.1.4",
    "description": "Order search with proxy",
    "main": "server/index.ts",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "vite",
        "dev:lan": "node scripts/dev.mjs --lan",
        "dev:web:lan": "vite --host 0.0.0.0",
        "lint:css": "stylelint \"public/css/**/*.css\" \"src/**/*.css\"",
        "lint:css:fix": "stylelint \"public/css/**/*.css\" \"src/**/*.css\" --fix",
        "type-check": "vue-tsc --noEmit",
        "type-check:server": "tsc -p tsconfig.server.json --noEmit",
        "type-check:test": "tsc -p tsconfig.test.json --noEmit",
        "test": "node --require tsx/cjs --test --test-concurrency=1 \"tests/**/*.test.ts\"",
        "test:visual": "RUN_VISUAL_TESTS=1 node --require tsx/cjs --test --test-concurrency=1 tests/procurement-visual-regression.test.ts",
        "test:visual:update": "RUN_VISUAL_TESTS=1 UPDATE_VISUAL_BASELINE=1 node --require tsx/cjs --test --test-concurrency=1 tests/procurement-visual-regression.test.ts",
        "build": "vue-tsc --noEmit && vite build",
        "share:prod": "npm run build && npm run server:prod",
        "preview": "vite preview",
        "preview:lan": "vite preview --host 0.0.0.0",
        "server:dev": "NODE_ENV=development tsx watch server/index.ts",
        "server:lan": "NODE_ENV=development tsx watch server/index.ts",
        "server:prod": "tsx server/index.ts",
        "db:migrate:add-order-category": "node server/scripts/migrate_add_order_category.js",
        "db:backfill:order-item-material-ids": "node server/scripts/backfill_order_item_material_ids.js",
        "inventory:reconcile:dry-run": "tsx server/scripts/reconcile_inventory_baseline.ts --json",
        "inventory:cleanup-zero-stock:dry-run": "tsx server/scripts/cleanup_zero_stock_materials.ts --json",
        "mapping:check:published": "tsx server/scripts/check_mapping_published_state.ts",
        "mapping:seed:published": "tsx server/scripts/seed_mapping_profiles.ts",
        "db:migrate:formulas": "node server/scripts/migrate_formulas_to_sqlite.js",
        "db:migrate:formula-keys": "node server/scripts/migrate_formula_keys_to_generated_format.js",
        "db:export:formulas": "node server/scripts/export_formulas_to_json.js",
        "audit:po-quantity-history": "tsx server/scripts/audit_po_quantity_history.ts",
        "start": "npm run server:prod",
        "material:mappings:backfill:dry-run": "tsx server/scripts/backfill_material_mappings.ts --dry-run --json",
        "material:mappings:audit": "tsx server/scripts/audit_material_mapping_conflicts.ts --json"
    },
    "dependencies": {
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lint": "^6.9.5",
        "@tailwindcss/postcss": "^4.1.18",
        "@tanstack/vue-table": "^8.21.3",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.13.4",
        "body-parser": "^2.2.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "codemirror": "^6.0.2",
        "cors": "^2.8.5",
        "express": "^4.22.1",
        "http-proxy-middleware": "^2.0.6",
        "jsdom": "^27.4.0",
        "lucide-vue-next": "^0.563.0",
        "pinia": "^3.0.4",
        "puppeteer": "^24.34.0",
        "reka-ui": "^2.9.1",
        "sequelize": "^6.37.7",
        "sqlite3": "^6.0.1",
        "tailwind-merge": "^3.4.0",
        "vee-validate": "^4.15.1",
        "vue-router": "^5.0.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^25.1.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "autoprefixer": "^10.4.24",
        "postcss": "^8.5.6",
        "stylelint": "^17.4.0",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vue": "^3.5.27",
        "vue-tsc": "^3.2.4"
    },
    "overrides": {
        "uuid": "^14.0.0"
    },
    "engines": {
        "node": ">=20.17.0"
    }
}
