{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "types": ["node"]
    },
    "include": [
        "server/**/*.ts",
        "src/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "src/**/*.vue",
        "node_modules"
    ]
}
