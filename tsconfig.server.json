{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "allowJs": true,
        "checkJs": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "server/**/*.ts",
        "server/**/*.d.ts",
        "src/**/*.ts",
        "shared/**/*.js",
        "shared/**/*.mjs"
    ]
}
