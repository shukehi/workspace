# 服务器配置
# Server Configuration
PORT=3000
NODE_ENV=development
# 生产环境必须配置：用于 PDF/打印统一渲染地址
# Required in production: unified render base url for PDF/print
# PRINT_RENDER_BASE_URL=https://your-frontend-domain.example.com

# ERP API 配置
# ERP API Configuration
ERP_BASE_URL=http://47.98.198.45:8802
ERP_TIMEOUT=30000

# CORS 配置
# CORS Configuration
# 允许的前端来源，多个用英文逗号分隔
# 不填则默认 http://localhost:5173（开发环境）
# 局域网示例：CORS_ORIGIN=http://192.168.1.100:5173
# 多来源示例：CORS_ORIGIN=http://localhost:5173,http://192.168.1.100:5173
CORS_ORIGIN=http://localhost:5173

# API 认证配置
# 前后端必须设置为相同的值。
# 开发环境（NODE_ENV=development）未设置时自动放行，无需配置。
# 生产环境必须配置，否则所有 /api 请求返回 500。
# API_KEY=change-me-before-deploy
# VITE_API_KEY=change-me-before-deploy

# 数据库配置（预留）
# Database Configuration (Reserved)
# DB_DIALECT=sqlite
# DB_STORAGE=./data/database.sqlite
# DB_LOGGING=true
